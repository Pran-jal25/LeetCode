class Solution {
  public:
    int findCeil(vector<int>& arr, int x) {
        // code her
        int n=arr.size(),low=0,high=n-1,mid,res=-1;
        
        while(low<=high)
        {
            mid=low+(high-low)/2;
            
            if(arr[mid]>=x)
            {
                res=mid;
                high=mid-1;
            }
            else
            {
                low=mid+1;
            }
        }
        return res;
    }
};
